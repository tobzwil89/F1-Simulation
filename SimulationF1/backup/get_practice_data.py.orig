def get_practice_data():

    # imports
    import requests
    from requests.auth import HTTPBasicAuth
    import pandas as pd
    from io import StringIO

    # use your email address in the username, and fill in your password
    username = ''
    password = ''
    file_url = 'https://team-analytics.com/f1/datacenter/remote/export_practice_data.php'

    # make a GET request with HTTP basic authentication
    response = requests.get(file_url, auth=HTTPBasicAuth(username, password), stream=True)

    # check if the request was successful and return data
    if response.status_code == 200:
        content = StringIO(response.text)
        df = pd.read_csv(content)
        return df
    else:
        return None